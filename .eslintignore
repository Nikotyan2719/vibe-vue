# ESLint ignore file
# Files and directories to be ignored by ESLint

# Nuxt
.nuxt
.output
.nitro
.nuxt-build
.nuxt-dev
.nuxt-types

# Node.js
node_modules
dist
*.log

# Build artifacts
*.min.*
*.map

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# Coverage
coverage
.nyc_output

# Test outputs
cypress/videos
cypress/screenshots
cypress/downloads

# Public directory (static assets)
public